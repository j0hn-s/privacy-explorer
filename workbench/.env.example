# workbench/.env.example — copy to .env for local use.
# Local defaults are fine; nothing here is sensitive in the MVP.

# Elasticsearch URL the backend connects to (compose-internal name).
ES_URL=http://elasticsearch:9200

# Where the privacy-explorer repository is mounted inside the backend container.
# Should match the volume mount in docker-compose.yml.
REPO_ROOT=/repo

# Workbench version label. Surfaced in /health and in the rendered HTML header.
WORKBENCH_VERSION=0.1.0-wip
